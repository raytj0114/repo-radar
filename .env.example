# ============================================================
# RepoRadar - Environment Variables
# ------------------------------------------------------------
# .env.local にコピーして値を設定すること。
# 変数を増減したら src/lib/env.ts のスキーマも必ず同時に更新する。
# ============================================================

# --- GitHub API（サーバー側PAT / read-only, public repos のみ） ---
# 発行: https://github.com/settings/personal-access-tokens
GITHUB_API_TOKEN=

# --- Auth.js (next-auth v5) ---
# 生成: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App: https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Gemini API ---
GOOGLE_GEMINI_API_KEY=

# --- Cron保護（Vercel Cronからの呼び出し検証用） ---
# 生成: openssl rand -hex 32
CRON_SECRET=

# --- Database ---
# ローカル (docker compose up -d)
DATABASE_URL=postgresql://postgres:password@localhost:5432/repo_radar
DIRECT_URL=postgresql://postgres:password@localhost:5432/repo_radar

# 本番 (Supabase):
#   DATABASE_URL = Transaction Pooler (port 6543, sslmode=require)
#   DIRECT_URL   = Direct connection (port 5432) ※migrate deploy 用
